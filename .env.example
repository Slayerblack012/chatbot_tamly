# API Key tu Google AI Studio (Bat buoc)
GEMINI_API_KEY=your_gemini_api_key_here

# Tuỳ chọn: nhiều API key phân cách bằng dấu phẩy để tự chuyển key dự phòng
# GEMINI_API_KEYS=your_primary_key_here,your_backup_key_here

# Model Gemini toi uu toc do va on dinh
GEMINI_MODEL=gemini-2.5-flash

# Cong may chu (Mac dinh: 8000)
PORT=8000
